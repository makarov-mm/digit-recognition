<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NeuralNet3D</AssemblyName>
    <RootNamespace>NeuralNet3D</RootNamespace>
  </PropertyGroup>

  <!-- Никаких внешних NuGet-зависимостей: System.Drawing и WinForms входят в Windows Desktop SDK,
       OpenGL берётся напрямую из opengl32.dll через P/Invoke (см. Gl.cs). -->

</Project>
